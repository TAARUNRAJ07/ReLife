#pragma once

/**
 * ==============================================================================
 * ReLife Hardware Test Rig - Secrets Configuration Example
 * ==============================================================================
 *
 * INSTRUCTIONS:
 * 1. Copy this file to `firmware/include/secrets.h`.
 * 2. Populate with your actual Wi-Fi credentials, backend host, and device keys.
 * 3. NEVER commit `secrets.h` to version control. It is explicitly ignored by .gitignore.
 *
 * HOW TO GENERATE A VALID DEVICE KEY:
 * A valid ReLife device key must be at least 32 bytes (256-bit) high-entropy cryptographic
 * hex-encoded string (64 hex characters).
 *
 * Command line options:
 *   Python:  python -c "import secrets; print(secrets.token_hex(32))"
 *   OpenSSL: openssl rand -hex 32
 *   Linux:   head -c 32 /dev/urandom | xxd -p -c 32
 * ==============================================================================
 */

#ifndef RELIFE_SECRETS_H
#define RELIFE_SECRETS_H

// --- Wi-Fi Network Access List ---
struct WifiCredential {
    const char* ssid;
    const char* password;
};

static const WifiCredential WIFI_NETWORKS[] = {
    {"ReLife-Lab-AP", "super-secret-lab-key"},
    {"ReLife-Mobile-Hotspot", "hotspot-password"}
};
static const size_t WIFI_NETWORKS_COUNT = sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

// --- Backend Connection ---
#define RELIFE_BACKEND_HOST "192.168.1.100"
#define RELIFE_BACKEND_PORT 8000
#define RELIFE_BACKEND_PATH_PREFIX "/api/v1"

// --- Hardware Device Identity & Authentication ---
// Device ID pattern: standard identifier for this physical rig
#define RELIFE_DEVICE_ID "ESP32-RIG-001"

// Device Key: 32-byte cryptographic random hex token (sent in X-Device-Key header)
// Generated via: python -c "import secrets; print(secrets.token_hex(32))"
#define RELIFE_DEVICE_KEY "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

// --- Root CA Certificate for TLS Pinned Validation (Release builds) ---
// In production builds (RELEASE_BUILD), the Root CA or intermediate cert MUST be pinned.
static const char ROOT_CA_PEM[] = 
"-----BEGIN CERTIFICATE-----\n"
"<<FROM_CERTIFICATE_AUTHORITY: Paste PEM Root CA here>>\n"
"-----END CERTIFICATE-----\n";

#endif // RELIFE_SECRETS_H
